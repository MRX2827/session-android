<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

<LinearLayout
    android:id="@+id/editorSurface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="11dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <View
        android:id="@+id/editorHandle"
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/editorIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_pencil"
            android:tint="?attr/colorAccent" />

        <TextView
            android:id="@+id/editMessageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/xsessionEditMessage"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/editMessageCancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="14dp"
            android:src="@drawable/ic_x"
            android:tint="?android:attr/textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/editorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="7dp"
        android:fontFamily="sans-serif-medium"
        android:labelFor="@id/editMessageText"
        android:text="@string/xsessionMessageText"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/editMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="5"
        android:minLines="3"
        android:padding="14dp"
        android:saveEnabled="false"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/editorError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="?attr/colorError"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/editMessageSave"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textSize="16sp" />
</LinearLayout>
</ScrollView>
